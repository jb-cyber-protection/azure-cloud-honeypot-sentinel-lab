// Title: SSH Credential Spray (Multiple IPs Targeting Same Username)
// Purpose: Detect many different source IPs attempting the same username (spray behavior).
// Data Source: Syslog (Linux), Facility auth/authpriv.
// Tuning:
//  - Adjust timeWindow (default 1h)
//  - Adjust thresholdIPs (default 5)
// False Positives:
//  - Very popular username (e.g., "root") might be attacked widely (still useful signal)

let timeWindow = 1h;
let thresholdIPs = 5;

Syslog
| where Facility in ("auth","authpriv")
| where TimeGenerated > ago(timeWindow)
| where SyslogMessage has_any ("Failed password", "Invalid user")
| extend SourceIP = extract(@"\b(\d{1,3}\.){3}\d{1,3}\b", 0, SyslogMessage)
| extend Username =
    coalesce(
        extract(@"Invalid user\s+(\S+)", 1, SyslogMessage),
        extract(@"Failed password for\s+(invalid user\s+)?(\S+)", 2, SyslogMessage)
    )
| where isnotempty(SourceIP) and isnotempty(Username)
| summarize DistinctIPs=dcount(SourceIP), IPs=make_set(SourceIP, 25), Attempts=count() by Username
| where DistinctIPs >= thresholdIPs
| order by DistinctIPs desc, Attempts desc
