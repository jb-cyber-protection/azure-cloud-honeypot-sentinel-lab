// Title: Successful SSH Login Detected
// Purpose: Detect successful SSH logins ("Accepted") and surface source IP + username.
// Data Source: Syslog (Linux), Facility auth/authpriv.
// Tuning:
//  - Narrow to specific usernames or exclude your own IP
// False Positives:
//  - Your legitimate logins. Add allowlist if needed.

let timeWindow = 7d;

Syslog
| where Facility in ("auth","authpriv")
| where TimeGenerated > ago(timeWindow)
| where SyslogMessage has "Accepted"
| extend SourceIP = extract(@"\b(\d{1,3}\.){3}\d{1,3}\b", 0, SyslogMessage)
| extend Username = extract(@"Accepted \S+ for (\S+) from", 1, SyslogMessage)
| project TimeGenerated, Username, SourceIP, SyslogMessage
| order by TimeGenerated desc
